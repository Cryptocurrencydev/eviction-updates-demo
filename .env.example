# Required
DATABASE_URL=postgres://localhost/dl_dev
APP_SECRET=any-long-random-string
APP_URL=http://localhost:3100

# Optional: real Stripe test mode. The billing simulator works without these.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional: real texts. Never set in the demo. Needs A2P 10DLC registration first.
MESSAGE_SENDER=simulated
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
